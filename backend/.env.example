# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (required)
DB_NAME=campus_parking
DB_USER=campus_parking_app
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis for Django Channels. Leave empty to use the in-memory layer (single process, dev only).
REDIS_URL=redis://127.0.0.1:6379/0

# Private folder for school ID photos. Keep it outside cloud-synced and public folders.
# PRIVATE_MEDIA_ROOT=C:/CampusParking/private_media

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
TIME_ZONE=Asia/Manila

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# SMTP email for event advisories, account decisions, reminders and password resets.
# Leave EMAIL_HOST empty to print emails in the backend window instead of sending them.
# Gmail: use EMAIL_HOST=smtp.gmail.com, turn on 2-Step Verification, and put the 16-character App Password below.
# Check your settings with: python manage.py send_test_email you@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Campus Parking Management System <your-account@example.com>
# Comma-separated demo domains that must never receive real email.
EMAIL_BLOCKED_DOMAINS=campus.edu
